# Copy to .env.local and fill in — .env.local is gitignored.

# Google Places API key, scoped to the "Places API (New)" product.
# Used by Agent 1 (Discovery) to source leads by industry + location.
GOOGLE_PLACES_API_KEY=

# Browser-side Google Maps key — enable "Maps JavaScript API" and
# "Places API" on it in Google Cloud Console. Powers the leads map on the
# Discovery dashboard and the location autocomplete field in the niche
# configurator. NEXT_PUBLIC_ because it ships to the client — restrict it
# to your domain(s) via HTTP referrer restrictions (Credentials > key >
# Application restrictions) so it can't be reused elsewhere if scraped.
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=

# --- Agent 2 (Outreach) — message drafting ---

# Anthropic API key — used to draft personalized outreach emails.
ANTHROPIC_API_KEY=

# --- Agent 2 (Outreach) — email sending ---

# Resend API key (resend.com). Used to actually send outreach emails.
RESEND_API_KEY=

# The verified "From" address, e.g. "StarSource <outreach@yourdomain.com>".
# Use a DEDICATED SENDING DOMAIN/SUBDOMAIN, not your primary business
# domain — a burned cold-outreach sender reputation shouldn't be able to
# poison deliverability for your normal company email. Add this domain in
# the Resend dashboard first; it will generate the exact SPF/DKIM records
# to add at your DNS provider, and give you a DMARC record to add too.
OUTREACH_FROM_EMAIL=

# Where prospect replies should actually land. The sending address above
# lives on a dedicated subdomain that likely isn't monitored — set this to
# an inbox you actually check (directly, or a forwarding alias on your
# root domain, e.g. hello@yourdomain.com forwarding to your real inbox).
REPLY_TO_EMAIL=

# Public base URL of this app (used to build unsubscribe links).
# Local dev: http://localhost:3000
APP_BASE_URL=

# Random secret used to sign unsubscribe links so they can't be forged/guessed.
UNSUBSCRIBE_SECRET=

# ISO date the sending domain started warming up, e.g. 2026-08-24.
# Controls the daily send cap (lib/warmup.ts) — omit and it's treated as
# day 0 (most conservative cap) every time.
OUTREACH_WARMUP_START_DATE=

# --- Login (magic-link, no database) ---

# Comma-separated list of emails allowed to sign in, e.g.
# ALLOWED_LOGIN_EMAILS=you@yourco.com,client@theirco.com
ALLOWED_LOGIN_EMAILS=

# Random secret used to sign magic-link and session tokens. Generate with:
# node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=
